{
  "name": "nestjs-multichannel-ai-chatbot-engine",
  "version": "0.1.0",
  "description": "Reusable multichannel AI chatbot engine built with NestJS and OpenAI",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "db:start": "docker compose up -d postgres",
    "db:stop": "docker compose stop postgres",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "knowledge:ingest": "nest start --entryFile rag/ingest-knowledge",
    "rag:evaluate": "nest start --entryFile rag/evaluate-rag",
    "chat:evaluate:security": "nest start --entryFile chat/evaluate-conversation-security",
    "format": "eslint . --fix && prettier --write .",
    "validate": "eslint . --max-warnings=0 && prettier --check . && tsc --noEmit && jest --coverage --runInBand && nest build",
    "test": "jest",
    "test:e2e": "jest --config jest.e2e.config.cjs --runInBand",
    "test:integration": "jest --config jest.integration.config.cjs --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "openai": "^7.4.0",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.1.28",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.4",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "jest": "^29.7.0",
    "prettier": "3.9.6",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0"
  }
}
