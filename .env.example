# Application
NODE_ENV=development
PORT=3000
BUSINESS_NAME=Café Nube
BUSINESS_TIME_ZONE=America/Lima
CORS_ALLOWED_ORIGINS=http://localhost:4173

# WhatsApp webhook verification (use a random value with at least 32 characters)
WHATSAPP_VERIFY_TOKEN=replace_with_a_random_value_at_least_32_chars
# Meta App Dashboard > App settings > Basic > App secret
WHATSAPP_APP_SECRET=replace_with_your_meta_app_secret
# Meta App Dashboard > WhatsApp > API setup > Access token
WHATSAPP_ACCESS_TOKEN=replace_with_your_whatsapp_access_token
WHATSAPP_GRAPH_API_VERSION=v25.0

# Database
DATABASE_URL=postgresql://chatbot:chatbot@localhost:5432/chatbot_engine?schema=public

# OpenAI — create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MAX_OUTPUT_TOKENS=1000
OPENAI_GENERATION_TIMEOUT_MS=20000
OPENAI_GENERATION_MAX_RETRIES=1
OPENAI_EMBEDDING_TIMEOUT_MS=8000
OPENAI_EMBEDDING_MAX_RETRIES=1

# Retrieval
RAG_MIN_SIMILARITY=0.5

# Web channel rate limiting
RATE_LIMIT_CONVERSATIONS_PER_HOUR=5
RATE_LIMIT_MESSAGES_PER_MINUTE=10
