generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ProductCategory {
  HOT_DRINK
  COLD_DRINK
  FOOD
}

enum MessageRole {
  USER
  ASSISTANT
}

enum ConversationTurnStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum WhatsAppOutboundStatus {
  PENDING
  ACCEPTED
  SENT
  DELIVERED
  READ
  FAILED
}

enum OrderStatus {
  STARTED
  SELECTING_PRODUCTS
  COLLECTING_CUSTOMER_DATA
  CONFIRMING_ORDER
  CONFIRMED
  CANCELLED
  EXPIRED
}

model Product {
  id                   String          @id @default(uuid()) @db.Uuid
  slug                 String          @unique
  name                 String
  description          String          @db.Text
  price                Decimal         @db.Decimal(10, 2)
  currency             String          @default("PEN") @db.Char(3)
  category             ProductCategory
  active               Boolean         @default(true)
  availableForOrdering Boolean         @default(true) @map("available_for_ordering")
  metadata             Json?           @db.JsonB
  orderItems           OrderItem[]
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("products")
}

model Promotion {
  id          String    @id @default(uuid()) @db.Uuid
  slug        String    @unique
  name        String
  description String    @db.Text
  startsAt    DateTime? @map("starts_at") @db.Timestamptz(3)
  endsAt      DateTime? @map("ends_at") @db.Timestamptz(3)
  active      Boolean   @default(true)
  metadata    Json?     @db.JsonB
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("promotions")
}

model Faq {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  question  String
  answer    String   @db.Text
  category  String
  active    Boolean  @default(true)
  metadata  Json?    @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("faqs")
}

model KnowledgeChunk {
  id         String                      @id @default(uuid()) @db.Uuid
  sourceType String                      @map("source_type")
  sourceId   String                      @map("source_id")
  chunkIndex Int                         @default(0) @map("chunk_index")
  content    String                      @db.Text
  metadata   Json?                       @db.JsonB
  embedding  Unsupported("vector(1536)")
  createdAt  DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([sourceType, sourceId, chunkIndex])
  @@map("knowledge_chunks")
}

model Conversation {
  id        String                @id @default(uuid()) @db.Uuid
  sessionId String                @map("session_id")
  channel   String
  messages  ConversationMessage[]
  turns     ConversationTurn[]
  orders    Order[]
  createdAt DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([channel, sessionId])
  @@map("conversations")
}

model ConversationMessage {
  id             Int          @id @default(autoincrement())
  conversationId String       @map("conversation_id") @db.Uuid
  role           MessageRole
  content        String       @db.Text
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, id])
  @@map("conversation_messages")
}

model ConversationTurn {
  conversationId String                 @map("conversation_id") @db.Uuid
  messageId      String                 @map("message_id") @db.VarChar(255)
  messageHash    String                 @map("message_hash") @db.Char(64)
  status         ConversationTurnStatus @default(PROCESSING)
  response       Json?                  @db.JsonB
  conversation   Conversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([conversationId, messageId])
  @@index([status, createdAt])
  @@map("conversation_turns")
}

model WhatsAppWebhookMessage {
  wabaId     String   @map("waba_id") @db.VarChar(64)
  messageId  String   @map("message_id") @db.VarChar(255)
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  @@id([wabaId, messageId])
  @@index([receivedAt])
  @@map("whatsapp_webhook_messages")
}

model WhatsAppOutboundMessage {
  id                 String                 @id @default(uuid()) @db.Uuid
  wabaId             String                 @map("waba_id") @db.VarChar(64)
  inboundMessageId   String                 @map("inbound_message_id") @db.VarChar(255)
  providerMessageId  String?                @unique @map("provider_message_id") @db.VarChar(255)
  status             WhatsAppOutboundStatus @default(PENDING)
  attemptCount       Int                    @default(1) @map("attempt_count")
  webhookReceivedAt  DateTime               @map("webhook_received_at") @db.Timestamptz(3)
  customerSentAt     DateTime?              @map("customer_sent_at") @db.Timestamptz(3)
  providerAcceptedAt DateTime?              @map("provider_accepted_at") @db.Timestamptz(3)
  sentAt             DateTime?              @map("sent_at") @db.Timestamptz(3)
  deliveredAt        DateTime?              @map("delivered_at") @db.Timestamptz(3)
  readAt             DateTime?              @map("read_at") @db.Timestamptz(3)
  failedAt           DateTime?              @map("failed_at") @db.Timestamptz(3)
  failureCode        String?                @map("failure_code") @db.VarChar(100)
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([wabaId, inboundMessageId])
  @@index([status, createdAt])
  @@map("whatsapp_outbound_messages")
}

model Order {
  id             String       @id @default(uuid()) @db.Uuid
  orderNumber    Int?         @unique @map("order_number")
  conversationId String       @map("conversation_id") @db.Uuid
  status         OrderStatus  @default(STARTED)
  customerName   String?      @map("customer_name") @db.VarChar(100)
  customerPhone  String?      @map("customer_phone") @db.VarChar(16)
  total          Decimal      @default(0) @db.Decimal(10, 2)
  currency       String       @default("PEN") @db.Char(3)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  items          OrderItem[]
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([conversationId, status])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  productName String   @map("product_name")
  unitPrice   Decimal  @map("unit_price") @db.Decimal(10, 2)
  quantity    Int
  lineTotal   Decimal  @map("line_total") @db.Decimal(10, 2)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([orderId, productId])
  @@index([productId])
  @@map("order_items")
}
